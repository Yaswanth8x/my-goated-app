# ============================================================
# Polymath OS — Environment Variables Architecture
# Workspace 1 Part 12 — PUBLIC vs SERVER SECRET
# ============================================================
# NEVER commit .env with real secrets to GitHub
# Copy this file to .env and fill with your own values
# ============================================================

# ------------------------------------------------------------
# PUBLIC — Safe to expose to browser (NEXT_PUBLIC_*)
# These are visible in client-side JavaScript, so never put secrets here
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: default AI provider for client UI (not secret)
NEXT_PUBLIC_AI_PROVIDER="mock"

# Feature Flags (PUBLIC)
NEXT_PUBLIC_AI_HUB_ENABLED="true"
NEXT_PUBLIC_RAG_ENABLED="true"
NEXT_PUBLIC_FREELANCE_ENABLED="false"
NEXT_PUBLIC_MULTI_USER_ENABLED="true"

# ------------------------------------------------------------
# SERVER SECRET — Never exposed to browser, server-only
# These are only available in API routes and server components
# ------------------------------------------------------------

# Supabase Service Role (SECRET — bypasses RLS, use only in server admin client)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# Database — Prisma points to Supabase Postgres in production, SQLite locally for quick dev
# For Supabase: postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://postgres:password@db.your-project.supabase.co:5432/postgres"

# Auth Secret — for NextAuth or custom session encryption (generate random 32+ chars)
AUTH_SECRET="replace-with-a-long-random-string-at-least-32-chars"

# Encryption key for user-provided AI keys stored in DB (32 chars)
ENCRYPTION_KEY="replace-with-32-char-encryption-key"

# ------------------------------------------------------------
# AI Providers — SERVER SECRET (never expose to client)
# User can also provide their own keys via Settings → AI Providers UI
# Those user keys are stored encrypted in DB, not here
# ------------------------------------------------------------

# OpenAI
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

# Google Gemini
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# Anthropic
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"

# OpenRouter (OpenAI-compatible, optional)
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_MODEL="openai/gpt-4o-mini"

# Mock provider — always works, no key needed, labeled MOCK RESPONSE
AI_PROVIDER="mock"

# ------------------------------------------------------------
# Optional — For future integrations (postponed)
# ------------------------------------------------------------
# GITHUB_TOKEN=""
# GOOGLE_DRIVE_CLIENT_ID=""
# GOOGLE_DRIVE_CLIENT_SECRET=""

# ------------------------------------------------------------
# How to use:
# 1. Copy: cp .env.example .env (Linux/Mac) or copy .env.example .env (Windows)
# 2. Fill Supabase URL and anon key from https://app.supabase.com/project/[project]/settings/api
# 3. For local dev, keep DATABASE_URL as file:./dev.db
# 4. For Supabase Postgres, change DATABASE_URL to postgresql://...
# 5. Generate AUTH_SECRET: openssl rand -base64 32 (Linux/Mac) or use random string generator
# 6. Never commit .env to GitHub — .gitignore already blocks it
# ------------------------------------------------------------
